{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "node",
            "request": "launch",
            "name": "Debug server.ts (Fastify)",
            "runtimeArgs": ["--env-file", ".env"],
            "program": "${workspaceFolder}/src/index.ts",
            "console": "integratedTerminal",
            "skipFiles": ["<node_internals>/**"]
        },
        {
            "type": "node",
            "request": "attach",
            "name": "Attach to LangGraph Studio",
            "port": 9229,
            "skipFiles": ["<node_internals>/**"],
            "restart": true
        }
    ]
}
